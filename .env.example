# Used by scripts/deploy.mjs when the variable is not already in the environment.
# Leave PRIVATE_KEY unset for a local Anvil deploy. The script uses Anvil account zero.
# PRIVATE_KEY=0xYOUR_TESTNET_OR_MAINNET_KEY

# Optional. Overrides the default RPC for the target you pass to deploy.mjs.
# RPC_URL=https://rpc.testnet.chain.robinhood.com

# Set to 0 to skip Blockscout verification on testnet and mainnet.
# VERIFY=1
